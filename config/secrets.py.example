# Copy this file to secrets.py and fill in your own values.
# secrets.py is gitignored — NEVER commit real cookies.
#
# nutcloud (jianguoyun.com) session cookies. To refresh them:
#   1. Log in to https://www.jianguoyun.com in your browser
#   2. DevTools (F12) -> Application -> Cookies -> www.jianguoyun.com
#   3. Copy the values below. They expire periodically; refresh when
#      searches start failing with auth errors.
nutstore_cookies = {
    "umn": "<your umn cookie>",
    "TDC_itoken": "<your TDC_itoken cookie>",
    "ta": "<your ta cookie>",
}
