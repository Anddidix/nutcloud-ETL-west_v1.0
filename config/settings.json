{
  "project_info": {
    "name": "AWB Batch Processor",
    "version": "2.0.0",
    "description": "Automated system for searching, downloading (via NutCloud), and consolidating AWB unloading plans"
  },
  "paths": {
    "input_directory": "./data/input",
    "output_directory": "./output",
    "log_directory": "./logs"
  },
  "file_patterns": {
    "excel_extensions": [
      ".xlsx",
      ".xls"
    ],
    "archive_extensions": [
      ".zip"
    ]
  },
  "delivery_methods": {
    "exclude_keywords": [
      "UPS",
      "快递",
      "COURIER",
      "EXPRESS"
    ]
  },
  "excel_columns": {
    "FBA_ID": [
      "SHIPMENT ID",
      "FBA NO.",
      "FBA#",
      "扩展单号",
      "FBA",
      "SHIPMENTID",
      "FBA ID"
    ],
    "PO_NUMBER": [
      "REFERENCE ID",
      "PO#",
      "PO NUMBER",
      "PO",
      "Amazon reference ID"
    ],
    "BOX_COUNT": [
      "PCS",
      "CTNS",
      "箱数/件数",
      "箱数",
      "件数",
      "CARTON COUNT",
      "CARTONS",
      "CARTON",
      "QUANTITY"
    ],
    "WEIGHT_KG": [
      "KGS",
      "GW",
      "重量",
      "实际重量(KG)",
      "实际重量",
      "WEIGHT",
      "G.W.",
      "G.W"
    ],
    "DESTINATION_FC": [
      "AMAZON",
      "亚马逊",
      "仓库代码",
      "派送目的地",
      "DESTINATION",
      "ADDRESS",
      "FC",
      "WAREHOUSE",
      "目的仓代码",
      "派送地址",
      "地址类别",
      "FBA CODE"
    ],
    "MISCELLANEOUS_NOTES": [
      "备注",
      "特殊指令/备注",
      "箱唛标签说明",
      "CCN#"
    ],
    "DELIVERY_METHOD": [
      "派送方式",
      "METHOD",
      "SERVICE",
      "服务类型"
    ]
  },
  "target_destinations": "ALL",
  "pod": {
    "template_path": "../POD 模版.xlsx",
    "destinations": [
      "YVR2",
      "YVR3",
      "YVR4",
      "YYC1",
      "YYC4",
      "YYC6",
      "YEG1",
      "YEG2",
      "CA-YVR4",
      "XCAB"
    ],
    "rows_per_page": 35,
    "max_pallets_per_page": 28,
    "ups_sheet_keywords": [
      "UPS",
      "快递",
      "COURIER",
      "EXPRESS"
    ]
  },
  "ups_record": {
    "template_path": "../UPS 模板.xlsx"
  },
  "gsheet": {
    "spreadsheet_id": "14Wqb_YfPaRG2BA4apjo2w6OpHzbhF_w3oLypcLGzmvs",
    "credentials_path": "config/google_credentials.json",
    "worksheet_name": null
  },
  "processing": {
    "skip_empty_po": false,
    "validate_totals": true,
    "generate_summary": true,
    "export_format": "xlsx",
    "output_columns": [
      "SOURCE_FILE",
      "FBA_ID",
      "PO_NUMBER",
      "BOX_COUNT",
      "WEIGHT_KG",
      "DESTINATION_FC",
      "MISCELLANEOUS_NOTES",
      "DELIVERY_METHOD"
    ]
  }
}